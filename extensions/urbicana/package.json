{
  "name": "@urbicana/openclaw-plugin",
  "version": "2026.9.8",
  "description": "OpenClaw plugin connecting a Gateway to its owner's Boostt account and keeping the owner's A2A card in the agent workspace.",
  "repository": {
    "type": "git",
    "url": "https://github.com/phaethonp/openclaw"
  },
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8"
    }
  }
}
